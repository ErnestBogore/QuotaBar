{
  "name": "quotabar",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "homepage": "https://github.com/ErnestBogore/QuotaBar",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErnestBogore/QuotaBar.git"
  },
  "bugs": {
    "url": "https://github.com/ErnestBogore/QuotaBar/issues"
